  create view "postgres"."public_pipedrive_analytics"."int_funnel_events__dbt_tmp"
    
    
  as (
    

-- Combine stage and activity events + deduplicate

with stage_events as (
    select
        dc.deal_id,
        dc.change_time as event_time,
        m.step_id,
        m.step_name,
        m.step_order,
        m.source_type
    from "postgres"."public_pipedrive_analytics"."stg_deal_changes" dc
    join "postgres"."public_pipedrive_analytics"."int_funnel_step_mapping" m
      on m.source_type = 'stage'
     and dc.new_value::numeric = m.step_id
    where dc.changed_field_key = 'stage_id'
),

activity_events as (
    select
        a.deal_id,
        a.due_date as event_time,
        m.step_id,
        m.step_name,
        m.step_order,
        m.source_type
    from "postgres"."public_pipedrive_analytics"."stg_activity" a
    join "postgres"."public_pipedrive_analytics"."stg_activity_type" at
      on a.activity_type = at.type_key
    join "postgres"."public_pipedrive_analytics"."int_funnel_step_mapping" m
      on at.activity_type_id = m.step_id
     and m.source_type = 'activity'
    where a.is_done = true
),

unioned as (
    select * from stage_events
    union all
    select * from activity_events
),

deduped as (
    select
        deal_id,
        step_id,
        step_name,
        step_order,
        source_type,
        event_time,
        row_number() over (
            partition by deal_id, step_id, event_time
            order by event_time
        ) as rn
    from unioned
)

select
    deal_id,
    step_id,
    step_name,
    step_order,
    source_type,
    event_time
from deduped
where rn = 1
  );
