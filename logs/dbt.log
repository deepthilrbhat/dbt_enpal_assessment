  create view "postgres"."public_pipedrive_analytics"."int_funnel_events__dbt_tmp"
    
    
  as (
    

-- Combine stage and activity events + deduplicate

with stage_events as (
    select
        dc.deal_id,
        dc.change_time as event_time,
        m.step_id,
        m.step_name,
        m.step_order,
        m.source_type
    from "postgres"."public_pipedrive_analytics"."stg_deal_changes" dc
    join "postgres"."public_pipedrive_analytics"."int_funnel_step_mapping" m
      on m.source_type = 'stage'
     and dc.new_value::numeric = m.step_id
    where dc.changed_field_key = 'stage_id'
),

activity_events as (
    select
        a.deal_id,
        a.due_date as event_time,
        m.step_id,
        m.step_name,
        m.step_order,
        m.source_type
    from "postgres"."public_pipedrive_analytics"."stg_activity" a
