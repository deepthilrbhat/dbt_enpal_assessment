left join "postgres"."public_pipedrive_analytics"."stg_users" cu on d.deal_current_owner_id = cu.user_id
left join "postgres"."public_pipedrive_analytics"."stg_users" pu on d.deal_previous_owner_id = pu.user_id
order by f.deal_id, f.step_order, f.stage_entered_time
  );
  
