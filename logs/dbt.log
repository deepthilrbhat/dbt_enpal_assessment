  create  table "postgres"."public_mart"."fct_deals_curated__dbt_tmp"
  
  
    as
  
  (
    

select
    f.deal_id,
    d.deal_creation_time,
    d.deal_current_owner_id,
    cu.user_name as deal_current_owner_name,
    d.deal_previous_owner_id,
